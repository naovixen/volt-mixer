---
import Icon from "../ui/Icon.astro";

const messageIcons = ["circle-check", "info", "triangle-alert", "circle-x"];
---

<!--
    Messages about the whole page, one box each: always in the page, empty when idle, so a new one
    is announced (polite here; notice() in src/scripts/notices.ts gives an urgent one role="alert").
    Each box is a .message-box.notice-item[data-notice-item] holding its .message.notice-text, an
    optional action button and a Dismiss button cloned from #notice-dismiss; its kind's icon comes
    from #message-icons.
-->
<div class="notice" aria-live="polite" data-notice></div>
<template id="notice-dismiss">
    <button class="button button--icon dismiss" type="button" data-notice-dismiss>
        <Icon name="close" />
        <span class="visually-hidden">Dismiss</span>
    </button>
</template>
<template id="message-icons">
    {messageIcons.map((name) => (
        <span data-icon-name={name}>
            <Icon name={name} />
        </span>
    ))}
</template>

<style>
    /* Empty, it takes no space but stays in the page (the shared live-region rule, global.css). */
    .notice:not(:empty) {
        display: grid;
        gap: var(--space-between-text);
        margin-block-start: var(--space-between-blocks);
        margin-inline: var(--space-page-inline);
    }

    /* Each box is shared with the guide's tips (.message-box, src/styles/message.css). */

    /* Wider than body text: a notice is one or two sentences, best read on one line. */
    .notice :global(.notice-text) {
        max-inline-size: 90ch;
    }

    /* At the far end, whatever the message's length. */
    .dismiss {
        flex-shrink: 0;
        margin-inline-start: auto;
        border-color: transparent;
        background-color: transparent;
    }
</style>
