{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023"],
        "types": ["node"],
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "rewriteRelativeImportExtensions": true,
        "outDir": "out",
        "rootDir": ".."
    },
    "include": ["src/**/*.ts", "src/**/*.cts", "../src/lib/**/*.ts", "../src/data/*.json"],
    "exclude": ["src/**/*.test.ts", "../src/lib/**/*.test.ts", "../src/lib/engine/test-volt.ts"]
}
